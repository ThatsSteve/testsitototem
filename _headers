# Security and caching headers for Netlify / Cloudflare Pages (other hosts: copy the same values into the server config).
# If a form service is set in assets/js/config.js (formEndpoint), add its origin to connect-src here and in the
# Content-Security-Policy <meta> of every page (_source/lib.py).
# X-Robots-Tag and robots.txt keep this copy out of search engines: remove both when it becomes the official site.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-GiFal4+zzK+wP+hPIwOISEtlImLzsiPrCwbQ1Yik4w4='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; frame-src 'self'; connect-src 'self'; form-action 'self' mailto:; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Robots-Tag: noindex, nofollow

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/video/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
